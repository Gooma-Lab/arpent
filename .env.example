# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------------
# Fine-grained token, read-only on public repositories.
# Absent: GitHub enrichment is skipped, confidence drops by 25, the missing
# source is named in the verdict (DESIGN.md §6).
GITHUB_TOKEN=

# --- Model routing (plan D8) ------------------------------------------------
# The validator deliberately runs on the stronger model: it is the step that
# carries the value of the project. The Haiku/Sonnet gap on this step is a
# measurement case for project 2.
ARPENT_MODEL_PLANNER=claude-haiku-4-5
ARPENT_MODEL_VALIDATOR=claude-sonnet-5
ARPENT_MODEL_SYNTHESIZER=claude-sonnet-5

# --- Persistence (plan D6) --------------------------------------------------
# Default is local JSONL. Supabase is optional; a missing key must never break
# a run.
ARPENT_STORE=jsonl
SUPABASE_URL=
SUPABASE_KEY=
