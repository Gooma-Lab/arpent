# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Optional ---------------------------------------------------------------
# Fine-grained token: github.com/settings/personal-access-tokens/new
# Repository access -> Public Repositories (read-only). No further permission
# needs ticking; the tool only reads public repositories through the API.
# Raises the rate limit from 60 to 5,000 requests an hour — that is its only
# purpose.
# Absent: GitHub enrichment is skipped, confidence drops by 25, the missing
# source is named in the verdict (DESIGN.md §6).
GITHUB_TOKEN=

# --- Model routing (plan D8) ------------------------------------------------
# The validator deliberately runs on the stronger model: it is the step that
# carries the value of the project. The Haiku/Sonnet gap on this step is a
# measurement case for project 2.
ARPENT_MODEL_PLANNER=claude-haiku-4-5
ARPENT_MODEL_VALIDATOR=claude-sonnet-5
ARPENT_MODEL_SYNTHESIZER=claude-sonnet-5

# --- Persistence ------------------------------------------------------------
# Traces are written as JSONL and pushed to a Hugging Face dataset. No database
# is needed in v1, and none is planned before project 2 — see ARCHITECTURE.md
# §5. The variable is the seam, not an invitation to set something up.
ARPENT_STORE=jsonl

# One file per day, named after the UTC date of the run. Git-ignored.
ARPENT_TRACE_DIR=data/traces

# DATA.md §3. `arpent purge` deletes whole files past this window, so the
# window is measured in the same clock the filenames use.
ARPENT_TRACE_RETENTION_DAYS=90
